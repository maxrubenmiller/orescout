# Copy to web/.env and adjust. (web/.env is gitignored.)
# Note: API runs on 5167, not 5000 — macOS AirPlay Receiver squats port 5000 (returns 403 to
# preflight → CORS errors). See PROJECT_PLAN.md §6.8 / decision #34.
VITE_API_BASE_URL=http://localhost:5167/api/v1
VITE_API_KEY=dev-local-key-change-me
VITE_TILE_BASE_URL=http://localhost:7800
# Optional: set a Mapbox token to use Mapbox Satellite instead of the keyless Esri imagery.
VITE_MAPBOX_TOKEN=
