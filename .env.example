# Local development settings. Copy to .env (gitignored) and change as needed.
#
# The values committed in docker-compose.yml, src/OreScout.Api/appsettings.json and
# web/.env.example are LOCAL-ONLY defaults so the stack runs out of the box. They are not
# secrets, and a real deployment must override every one of them.

# Read by docker compose (docker-compose.yml).
POSTGRES_PASSWORD=postgres

# Read by the API (dotnet run). Export these in your shell; the API does not read this file.
# ORESCOUT_API_KEY=dev-local-key-change-me
# ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=miningapp;Username=postgres;Password=postgres"
